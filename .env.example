# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Cloud → chave de API restrita à Drive API e ao domínio da plataforma
NEXT_PUBLIC_GOOGLE_API_KEY=

# Segredo para o hash dos códigos de voto (gerar uma vez; não trocar depois de gerar os cartões)
VOTE_CODE_PEPPER=
