# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço do site (local: http://localhost:3000; Vercel: https://film-festival-nine.vercel.app).
# Usado como Referer nas chamadas do servidor ao Drive (a chave é restrita por domínio).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud → chave de API restrita à Drive API e ao domínio da plataforma
NEXT_PUBLIC_GOOGLE_API_KEY=

# Só para o Supabase CLI local (npm run sb / db:push / db:types). NÃO cadastrar na Vercel.
# Token da conta dona do projeto: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Segredo para o hash dos códigos de voto (gerar uma vez; não trocar depois de gerar os cartões)
VOTE_CODE_PEPPER=
